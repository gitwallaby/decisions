  P.appendChild(del);
}

/* ---------- 検索 ---------- */
const SEARCH_FIELDS = [['title', '名前'], ['purpose', '趣旨'], ['interp', '解釈'], ['factors', '考慮要素'], ['examples', '具体例'], ['note', 'メモ']];
function crumb(id) {
  const p = findPath(id);
  return p ? p.slice(0, -1).map(i => data.nodes[i].title || '無題').join(' › ') : '（未接続）';
}
function renderResults() {
  const box = $('#results'); box.textContent = '';
  const q = $('#q').value.trim();
  if (!q) { searchHits = []; return; }
  const lq = q.toLowerCase(), hits = [];
  Object.values(data.nodes).forEach(n => {
    const f = SEARCH_FIELDS.find(([k]) => (n[k] || '').toLowerCase().includes(lq));
    if (f) hits.push({ n, f });
  });
  searchHits = hits.map(h => h.n.id);
  box.appendChild(el('div', 'resinfo', hits.length ? hits.length + '件　（Enter＝次へ／Shift+Enter＝前へ／Esc＝消す）' : '見つかりません'));
  if (!hits.length) return;
  const list = el('div', 'reslist');
  hits.slice(0, 60).forEach(({ n, f }, i) => {
    const b = el('button', 'res' + (i === searchIdx ? ' act' : ''));
    const t = el('div', 'rt'); hl(t, n.title || '（無題）', q); b.appendChild(t);
    let sub = crumb(n.id);
    if (f[0] !== 'title') {
      const tx = (n[f[0]] || '').replace(/\s+/g, ' '), j = tx.toLowerCase().indexOf(lq);
      sub += '　／　' + f[1] + '：…' + tx.slice(Math.max(0, j - 10), j + q.length + 24) + '…';
    }
    b.appendChild(el('div', 'rs', sub));
    b.onclick = () => { searchIdx = i; reveal(n.id); };
    list.appendChild(b);
  });
  box.appendChild(list);
}
function stepHit(d) {
  if (!searchHits.length) return;
  searchIdx = searchIdx < 0 ? (d > 0 ? 0 : searchHits.length - 1) : (searchIdx + d + searchHits.length) % searchHits.length;
  reveal(searchHits[searchIdx]);
}

function clearAll() {
  if (!confirm('このブラウザの中のデータを全部消して、白紙にします。取り消せません。よろしいですか？（データファイルに接続中の場合は、ファイルも白紙で上書きされます）')) return;
  data = { version: 2, nodes: {}, roots: [] };
  selKey = null; editing = false; expanded = new Set(); showSampleNote = false;
  changed(); render(); showBanner('');
}

function render() {
  if (selKey && !validKey(selKey)) { const l = selId(); selKey = data.nodes[l] ? l : null; if (!selKey) editing = false; }
  searchQ = $('#q').value.trim();
  renderTree(); renderPanel(); renderResults(); refreshStatus();
  if (showSampleNote) showBanner('サンプルです。内容は自分の理解・教材に合わせて書き換えてください（正確性は保証しません）。何か編集するとこの表示は消えます。', 'info', [['サンプルを消して白紙から始める', clearAll]]);
  else if ($('#banner').textContent.startsWith('サンプルです')) showBanner('');
  focusIfWanted();
}


/* ---------- 起動 ---------- */
loadKeys();
$('#btnSamples').onclick = addOtherSamples;
$('#btnOpen').onclick = openFile;
$('#btnSaveAs').onclick = saveAs;
$('#btnExport').onclick = exportFile;
$('#btnImport').onclick = () => $('#fileIn').click();
$('#btnClear').onclick = clearAll;
$('#fileIn').onchange = e => { importFile(e.target.files[0]); e.target.value = ''; };
$('#btnKeys').onclick = () => { capturing = null; $('#keysMsg').textContent = ''; renderKeys(); $('#keysDlg').showModal(); };
$('#keysClose').onclick = () => { capturing = null; $('#keysDlg').close(); renderPanel(); render(); };
$('#keysReset').onclick = () => { ACTIONS.forEach(a => { keymap[a.id] = a.def; }); saveKeys(); capturing = null; $('#keysMsg').textContent = ''; renderKeys(); };
$('#keysDlg').addEventListener('cancel', e => { if (capturing) e.preventDefault(); });
$('#q').addEventListener('input', () => { searchIdx = -1; searchQ = $('#q').value.trim(); renderResults(); renderTree(); });
$('#q').addEventListener('keydown', e => {
  if (e.isComposing || e.keyCode === 229) return;
  if (e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); stepHit(e.shiftKey ? -1 : 1); }
  else if (e.key === 'ArrowDown') { e.preventDefault(); e.stopPropagation(); stepHit(1); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); e.stopPropagation(); stepHit(-1); }
  else if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); $('#q').value = ''; searchIdx = -1; $('#q').blur(); render(); }
});
document.querySelectorAll('.depth button').forEach(b => b.onclick = () => expandTo(+b.dataset.d));
$('#btnRoot').onclick = () => {
  const id = uid(); data.nodes[id] = newNode(id, ''); data.roots.push(id); afterCreate(id);
};

// キーの変更（割り当て待ち）
document.addEventListener('keydown', e => {
  if (!capturing) return;
  e.preventDefault(); e.stopPropagation();
  if (['Shift', 'Control', 'Alt', 'Meta'].includes(e.key)) return;
  const a = ACTIONS.find(x => x.id === capturing), ks = keyStr(e), msg = $('#keysMsg');
  if (e.key.length === 1 && !(e.ctrlKey || e.metaKey || e.altKey) && a.scope !== 'select') { msg.textContent = '文字入力と重なるため、このキーは使えません（CtrlやAltを組み合わせてください）'; return; }
  const bad = ACTIONS.find(x => x.id !== a.id && keymap[x.id] === ks && SCOPES[x.scope].some(s => SCOPES[a.scope].includes(s)));
  if (bad) { msg.textContent = '「' + bad.label + '」と重複しています'; return; }
  keymap[a.id] = ks; saveKeys(); capturing = null; msg.textContent = ''; renderKeys();
}, true);

// 通常のキー操作（Excel風：選択中は、名前欄の外でも使える）
document.addEventListener('keydown', e => {
  if (capturing || e.isComposing || e.keyCode === 229 || $('#keysDlg').open) return;
  const ks = keyStr(e), t = e.target, tag = t.tagName;
  const inTitle = t.classList && t.classList.contains('tin');
  const ctx = inTitle ? 'edit' : ((tag === 'TEXTAREA' || tag === 'INPUT' || tag === 'SELECT') ? 'field' : 'select');
  const act = ACTIONS.find(a => keymap[a.id] && keymap[a.id] === ks && SCOPES[a.scope].includes(ctx));
  if (!act) return;
  if (ctx === 'select' && tag === 'BUTTON' && act.id !== 'search') return;
  if (runAction(act.id)) e.preventDefault();
});
window.addEventListener('beforeunload', e => { if (fileHandle && fileDirty) { e.preventDefault(); e.returnValue = ''; } });
if (!canFile) { $('#btnOpen').hidden = true; $('#btnSaveAs').hidden = true; }

(async function init() {
  let loaded = false;
  try { const s = localStorage.getItem(LS_KEY); if (s) { data = normalize(JSON.parse(s)); loaded = true; } } catch (e) {}
  if (!loaded) { data = sampleData(); showSampleNote = true; }
  data.roots.forEach(r => expanded.add(r));
  render();
  if (!canFile) {
    showBanner('このブラウザではファイルへの自動保存は使えません（PCのChrome・Edgeで開いてください）。今はブラウザ内に保存され、「書き出し」でファイルにできます。');
    return;
  }
  try {
    const h = await idbGet('handle');
    if (h) {
      showBanner('前回のデータファイル「' + h.name + '」につなぎ直せます。', 'info', [['つなぎ直して読み込む', async () => {
        try {
          if (!(await ensurePerm(h))) return;
          const text = await (await h.getFile()).text();
          if (text.trim()) loadData(JSON.parse(text));
          await connect(h);
          if (!text.trim()) await writeFile();
          try { localStorage.setItem(LS_KEY, serialize()); } catch (e) {}
          lastSaved = new Date(); refreshStatus(); showBanner('');
        } catch (e) { showBanner('つなぎ直せませんでした：' + (e.message || e), 'err'); }
      }]]);
    }
  } catch (e) {}
})();
})();
</script>
