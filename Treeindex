<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>判断ロジックツリー</title>
<style>
:root{
  --bg:#f3f5f8;--card:#fff;--fg:#1d2330;--sub:#657084;--line:#bcc5d3;--acc:#2b6cb0;
  --req:#1f5fa8;--reqbg:#e3effc;--exc:#c0392b;--excbg:#fdebe8;--or:#a96d0a;--orbg:#fdf0d2;
  --wg:#7b3fb0;--wgbg:#efe3fb;
  --c0:rgba(123,63,176,.11);--c1:rgba(43,108,176,.11);--c2:rgba(169,109,10,.13);
  --sel:#fff6cf;--ok:#2f855a;--warn:#a96d0a;--err:#c0392b;--field:#fbfcfd;--border:#d5dbe5;
}
@media (prefers-color-scheme:dark){
  :root{--bg:#12151a;--card:#1c2129;--fg:#e6e9ef;--sub:#9aa5b8;--line:#4a566c;--acc:#63a4e8;
  --req:#8ec1f5;--reqbg:#1d3550;--exc:#f2998f;--excbg:#4a2523;--or:#e8b95a;--orbg:#4a3a17;
  --wg:#c9a2f0;--wgbg:#3b2a52;
  --c0:rgba(201,162,240,.16);--c1:rgba(99,164,232,.16);--c2:rgba(232,185,90,.16);
  --sel:#3a3516;--ok:#68d391;--warn:#e8b95a;--err:#f2998f;--field:#161b22;--border:#33405a;}
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:"Hiragino Sans","Yu Gothic UI","Meiryo",system-ui,sans-serif;font-size:15px;line-height:1.55}
header{position:sticky;top:0;z-index:20;background:var(--card);border-bottom:1px solid var(--border);padding:8px 14px;display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px}
h1{font-size:17px;margin:0}
.btns{display:flex;flex-wrap:wrap;gap:6px;margin-left:auto}
button{font:inherit;font-size:13px;padding:6px 10px;border:1px solid var(--border);background:var(--card);color:var(--fg);border-radius:8px;cursor:pointer}
button:hover{border-color:var(--acc)}
button.primary{background:var(--acc);border-color:var(--acc);color:#fff}
button.danger{color:var(--err);border-color:var(--err)}
button.sm{padding:2px 8px;font-size:12px}
button.on{background:var(--acc);border-color:var(--acc);color:#fff}
.chip{display:inline-block;font-size:12px;padding:3px 10px;border-radius:99px;border:1px solid var(--border)}
.st.ok{color:var(--ok);border-color:var(--ok)}
.st.warn{color:var(--warn);border-color:var(--warn)}
.st.err{color:var(--err);border-color:var(--err)}
#banner{padding:0 14px}
.note{margin:10px 0 0;padding:8px 12px;border-radius:8px;background:var(--orbg);color:var(--fg);font-size:13px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.note.err{background:var(--excbg)}
.main{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:14px;padding:14px;align-items:start}
.pane{background:var(--card);border-radius:12px;padding:12px;border:1px solid var(--border)}
.toolbar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:8px}
.toolbar input[type=search]{flex:1 1 140px;min-width:0}
input[type=text],input[type=search],textarea,select{font:inherit;width:100%;padding:7px 9px;border:1px solid var(--border);border-radius:8px;background:var(--field);color:var(--fg)}
textarea{resize:vertical}
.depth{display:flex;gap:4px;align-items:center;font-size:12px;color:var(--sub)}
/* 検索 */
#results{margin-bottom:8px}
.resinfo{font-size:12px;color:var(--sub);margin:0 0 4px}
.reslist{max-height:230px;overflow:auto;border:1px solid var(--border);border-radius:8px}
.res{display:block;width:100%;text-align:left;border:none;border-bottom:1px solid var(--border);border-radius:0;padding:5px 10px;background:var(--card)}
.res:last-child{border-bottom:none}
.res.act{background:var(--sel)}
.res .rt{font-weight:700;font-size:13px}
.res .rs{font-size:11px;color:var(--sub);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
mark{background:#ffe066;color:#222;border-radius:2px;padding:0 1px}
/* ツリー */
#tree{max-height:calc(100vh - 230px);overflow:auto;padding:8px 10px 60px 8px}
ul.roots,ul.kids{list-style:none;margin:0;padding:0}
ul.kids{margin-left:14px;position:relative}
.minus{position:absolute;left:-8px;top:2px;width:18px;height:18px;padding:0;border-radius:50%;font-size:14px;line-height:14px;text-align:center;z-index:2;background:var(--card);border:1px solid var(--line);color:var(--sub)}
.minus:hover{border-color:var(--acc);color:var(--acc)}
li.rootli{margin:4px 0 10px}
li.kid{position:relative;padding-left:22px}
li.kid::before{content:'';position:absolute;left:0;top:18px;width:18px;border-top:2px solid var(--line)}
li.kid::after{content:'';position:absolute;left:0;top:0;bottom:0;border-left:2px solid var(--line)}
li.kid:last-child::after{bottom:auto;height:18px}
li.kid.exc::before{border-top:2px dashed var(--exc)}
/* AND：青の太い線で束ねる */
li.kid.andkid::before{border-top:3px solid var(--req);width:19px}
li.kid.andkid::after{border-left:3px solid var(--req);left:-1px}
li.kid.andkid>.row,li.kid.andkid>.fbg>.row,li.kid.andkid>.fbg>.stack>.row,li.kid.andkid>.stack>.row{border-left:3px solid var(--req);border-radius:0 8px 8px 0}
/* OR：橙 */
li.kid.orkid::before{border-top:3px solid var(--or);width:19px}
li.kid.orkid::after{border-left:3px solid var(--or);left:-1px}
li.kid.orkid>.row,li.kid.orkid>.fbg>.row,li.kid.orkid>.fbg>.stack>.row,li.kid.orkid>.stack>.row{border-left:3px solid var(--or);border-radius:0 8px 8px 0}
/* 総合考慮：紫 */
li.kid.wgkid::before{border-top:3px solid var(--wg);width:19px}
li.kid.wgkid::after{border-left:3px solid var(--wg);left:-1px}
li.kid.wgkid>.row,li.kid.wgkid>.fbg>.row,li.kid.wgkid>.fbg>.stack>.row,li.kid.wgkid>.stack>.row{border-left:3px solid var(--wg);border-radius:0 8px 8px 0}
li.sep,li.ghead{position:relative;padding-left:22px}
li.sep{height:20px}
li.sep::after,li.ghead::after{content:'';position:absolute;top:0;bottom:0;left:-1px;border-left:3px solid var(--line)}
li.sep.and::after,li.ghead.and::after{border-left-color:var(--req)}
li.sep.or::after,li.ghead.or::after{border-left-color:var(--or)}
li.ghead.wg::after{border-left-color:var(--wg)}
li.sep span{margin-left:34px;font-size:12px;font-weight:700;line-height:20px}
li.sep.and span{color:var(--req)}
li.sep.or span{color:var(--or)}
li.ghead{padding-top:2px;padding-bottom:2px}
li.ghead span{display:inline-block;margin-left:8px;font-size:12px;font-weight:700;padding:1px 10px;border-radius:99px}
li.ghead.and span{background:var(--reqbg);color:var(--req)}
li.ghead.or span{background:var(--orbg);color:var(--or)}
li.ghead.wg span{background:var(--wgbg);color:var(--wg)}
/* 行 */
.row{display:flex;align-items:center;flex-wrap:wrap;gap:6px;min-height:36px;padding:2px 8px;border-radius:8px;cursor:pointer;border:1px solid transparent}
.row:hover{background:rgba(127,127,127,.12)}
.row.sel{background:var(--sel);border-color:var(--acc)}
.ttl{font-weight:600}
.ttl.blank{color:var(--sub);font-weight:400}
.row.rootrow .ttl,.row.rootrow .tin{font-size:16px}
.tin{font:inherit;font-weight:600;border:none;border-bottom:1px dashed var(--acc);background:transparent;color:var(--fg);padding:2px 0;flex:1;min-width:6em;width:auto;outline:none;border-radius:0}
.badge{font-size:11px;padding:1px 7px;border-radius:99px;font-weight:700;white-space:nowrap}
.badge.req{background:var(--reqbg);color:var(--req)}
.badge.exc{background:var(--excbg);color:var(--exc)}
.badge.or{background:var(--orbg);color:var(--or)}
.badge.wg{background:var(--wgbg);color:var(--wg)}
.badge.tier{background:rgba(127,127,127,.18);color:var(--fg)}
.badge.unset{border:1px dashed var(--sub);color:var(--sub);background:none}
.cnt{font-size:11px;color:var(--sub);border:1px solid var(--line);border-radius:99px;padding:0 6px;white-space:nowrap}
.cnt.open{opacity:.55}
.has{font-size:12px;color:var(--sub)}
.shared{font-size:11px;color:var(--sub)}
.mapc{font-size:11px;font-weight:700;border:1px solid;border-radius:99px;padding:0 7px;white-space:nowrap;background:none}
.mapc.l0{color:var(--wg)}.mapc.l1{color:var(--acc)}.mapc.l2{color:var(--or)}
.unh{margin:14px 0 6px;font-size:12px;color:var(--sub)}
.chipb{margin:2px 4px 2px 0}
.empty{color:var(--sub);font-size:14px;padding:10px 2px}
/* 枠組みの重ね表示（背景・はみ出し帯） */
.fbg{position:relative;margin:7px 0;border-radius:8px;background:var(--c0)}
.fbg.n1{box-shadow:0 0 0 5px var(--c0)}
.fbg.n2{box-shadow:0 0 0 5px var(--c0),0 0 0 10px var(--c1)}
.fbg.n3{box-shadow:0 0 0 5px var(--c0),0 0 0 10px var(--c1),0 0 0 15px var(--c2)}
.stack{position:relative;isolation:isolate}
.stack>.row{position:relative;z-index:10;background:var(--card)}
.stack>.row.sel{background:var(--sel)}
.layer{position:absolute;top:0;border-radius:8px;border:1px solid var(--wg);background:var(--wgbg)}
.layer.l1{border-color:var(--acc);background:var(--reqbg)}
.layer.l2{border-color:var(--or);background:var(--orbg)}
.layer .lab{position:absolute;left:8px;right:6px;bottom:0;height:16px;line-height:15px;font-size:11px;font-weight:700;color:var(--wg);background:none;border:none;padding:0;text-align:left;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;border-radius:0}
.layer.l1 .lab{color:var(--req)}
.layer.l2 .lab{color:var(--or)}
.layer.open .lab{text-decoration:underline}
.frameview{margin:0 0 8px 6px;border:1px solid var(--wg);border-radius:8px;padding:6px 10px;background:var(--card)}
.frameview.l1{border-color:var(--acc)}
.frameview.l2{border-color:var(--or)}
.frameview .fh{display:flex;gap:6px;align-items:center;flex-wrap:wrap;font-size:12px;font-weight:700}
.frameview .fh .sp{flex:1}
.frameview .fp{font-size:12px;color:var(--sub);margin:2px 0 4px}
.frameview .fi{margin:5px 0;font-size:13px}
.frameview .fi .l1r{display:flex;gap:6px;align-items:baseline;cursor:pointer}
.frameview .fi .sn{font-size:12px;color:var(--sub)}
.frameview .fi .l2r{margin:2px 0 0 28px;font-size:12px;display:flex;gap:4px;flex-wrap:wrap;align-items:center}
.badge.miss{border:1px dashed var(--err);color:var(--err);background:none}
/* 詳細欄（編集モード） */
.detail{margin:2px 0 8px 6px;border:1px dashed var(--acc);border-radius:8px;padding:6px 8px;background:var(--card)}
.dhead{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.dhead .lab{font-size:12px;color:var(--sub)}
.dhead input[type=text]{width:7em;padding:2px 6px;font-size:12px}
.dhead select{width:auto;padding:2px 6px;font-size:12px}
.dsec{margin-top:4px}
.dsec>button.dh{display:block;width:100%;text-align:left;border:none;background:none;padding:3px 0;font-size:12px;font-weight:700;color:var(--sub)}
.dsec>button.dh:hover{color:var(--acc)}
.dsec .dot{color:var(--acc)}
.dsec textarea{min-height:56px;font-size:14px;line-height:1.55;overflow:hidden}
.dsec .hint{margin:0 0 3px}
.mrow{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin:3px 0;font-size:12px}
.mrow select{width:auto;flex:1 1 200px;padding:2px 6px;font-size:12px}
/* 右パネル */
#panel{position:sticky;top:64px;max-height:calc(100vh - 80px);overflow:auto}
#panel h2{font-size:15px;margin:0 0 10px;word-break:break-all}
.fld{margin-bottom:12px}
.fld label{display:block;font-weight:700;font-size:13px}
.hint{font-size:12px;color:var(--sub);margin-bottom:3px}
.sec{margin:16px 0 6px;font-weight:700;font-size:13px;border-top:1px solid var(--border);padding-top:12px}
.krow{display:flex;gap:6px;align-items:center;margin:4px 0;flex-wrap:wrap}
.krow select{width:auto;flex:none}
.krow .kt{flex:1;min-width:6em;text-align:left;border:none;background:none;color:var(--acc);padding:4px;text-decoration:underline;cursor:pointer}
.inl{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0}
.inl input,.inl select{flex:1 1 150px;width:auto;min-width:0}
.mk{display:flex;gap:4px;flex-wrap:wrap}
kbd{font:inherit;font-size:11px;border:1px solid var(--border);border-bottom-width:2px;border-radius:4px;padding:0 5px;background:var(--field);color:var(--fg)}
details{font-size:13px;color:var(--sub);margin:0 14px}
details summary{cursor:pointer;padding:8px 0 0}
/* キー設定ダイアログ */
dialog{border:1px solid var(--border);border-radius:12px;background:var(--card);color:var(--fg);padding:16px;max-width:620px;width:92vw}
dialog::backdrop{background:rgba(0,0,0,.4)}
dialog h3{margin:0 0 6px;font-size:16px}
.krw{display:flex;gap:8px;align-items:center;padding:5px 0;border-bottom:1px solid var(--border)}
.krw .kl{flex:1;font-size:13px}
.krw .kk{min-width:8em;text-align:center}
#keysMsg{min-height:1.4em;color:var(--err);font-size:12px;margin:6px 0}
.dfoot{display:flex;gap:8px;justify-content:flex-end;margin-top:10px}
@media(max-width:820px){
  .main{grid-template-columns:1fr}
  #tree{max-height:60vh}
  #panel{position:static;max-height:none}
}
</style>
</head>
<body>
<header>
  <h1>判断ロジックツリー</h1>
  <span id="status" class="chip st warn" title="書いた内容は、このブラウザの中（またはあなたが選んだデータファイル）にだけ保存され、公開されません">起動中…</span>
  <div class="btns">
    <button id="btnSamples" title="会計・数学・暮らし・スポーツ・経済の試しツリーを追加／最新版に入れ替え">＋他分野のサンプル</button>
    <button id="btnKeys" title="キー操作の割り当てを変更">⌨ キー設定</button>
    <button id="btnOpen" title="自分のPCにあるデータファイルを開く">📂 ファイルを開く</button>
    <button id="btnSaveAs" title="データの保存先ファイルを新しく作る">💾 保存先ファイルを作る</button>
    <button id="btnExport" title="データをファイルとしてダウンロード">⬇ 書き出し</button>
    <button id="btnImport" title="書き出したファイルを読み込む">⬆ 読み込み</button>
    <input type="file" id="fileIn" accept=".json,application/json" hidden>
  </div>
</header>
<details>
  <summary>使い方・データの扱い</summary>
  <p><b>データの扱い</b>：このページ（アプリ本体・GitHub）には、書いた内容は一切入りません。内容は、別のデータファイル（あなたのGoogleドライブなど）にだけ保存されます。内容は「①このブラウザの中（自動保存）」と「②あなたが選んだデータファイル」にだけ保存され、ネットには送られません。ブラウザの履歴・サイトデータを消すと①は消えるので、「💾 保存先ファイルを作る」でGoogleドライブなど非公開の場所にファイルを作っておくと安心です（PCのChrome・Edge）。</p>
  <p><b>操作</b>：ブロックを1回クリック＝選択して下位要件を一階層ひらく。もう1回クリック（またはダブルクリック、<kbd>F2</kbd>）＝編集モード（名前の編集と詳細欄が開く）。<kbd>Esc</kbd>で編集モードを終える。下位要件を閉じるには、線の途中の「−」。ブロックの右の「↳3」は、下に3つ要素があるという印です。</p>
  <p><b>ブロックを作る</b>：<kbd>Enter</kbd>＝下、<kbd>Shift</kbd>+<kbd>Enter</kbd>＝上、<kbd>Tab</kbd>＝右（一階層下）、<kbd>Shift</kbd>+<kbd>Tab</kbd>＝左（一階層上）。新しいブロックは「未設定」で、要件か「ただし」かは詳細欄の「位置づけ」であとから選びます。キーは「⌨ キー設定」で変えられます。<kbd>Ctrl</kbd>+<kbd>F</kbd>＝検索。</p>
  <p><b>要件の組み方</b>：「すべて必要」は青の太い線で束ねて①②③。「どれか1つ」は橙色でA・B・C。「総合考慮」は紫色で、ウェイトと優先度（一次的・副次的・補充的）を書けます。</p>
  <p><b>枠組みの重ね表示</b>：枠組みを重ねたブロックは、ツリー全体の背景に枠組みの色が付き、下に「枠組み：〇〇」の帯が出ます。帯をクリックするとチェック表が開き、各要件がどの要素に対応しているか（未対応はどれか）が分かります。対応は、編集モードの詳細欄「枠組みとの対応」で選びます。</p>
  <p><button id="btnClear" class="sm danger">データを全部消して白紙にする</button> <span>（取り消せません。先に「書き出し」をおすすめします）</span></p>
</details>
<div id="banner"></div>
<div class="main">
  <section class="pane">
    <div class="toolbar">
      <input type="search" id="q" placeholder="検索（Ctrl+F）名前・趣旨・解釈・メモ…">
      <div class="depth"><span>開く段数</span>
        <button class="sm" data-d="0">閉</button><button class="sm" data-d="1">1</button><button class="sm" data-d="2">2</button><button class="sm" data-d="3">3</button><button class="sm" data-d="4">4</button><button class="sm" data-d="99">全</button>
      </div>
      <button id="btnRoot" class="primary sm">＋新しい根（最終的な効果）</button>
    </div>
    <div id="results"></div>
    <div id="tree"></div>
  </section>
  <section class="pane" id="panel"></section>
</div>
<dialog id="keysDlg">
  <h3>キー設定</h3>
  <div class="hint">「変更」を押してから、割り当てたいキーを押してください。<kbd>Ctrl</kbd>や<kbd>Alt</kbd>、<kbd>Shift</kbd>との組み合わせも使えます。</div>
  <div id="keysBody"></div>
  <div id="keysMsg"></div>
  <div class="dfoot"><button id="keysReset">初期設定に戻す</button><button id="keysClose" class="primary">閉じる</button></div>
</dialog>

<script>
(() => {
'use strict';
const LS_KEY = 'lawtree_v1', PREF_KEY = 'lawtree_prefs', KEYS_KEY = 'lawtree_keys';
const $ = s => document.querySelector(s);
const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
const uid = () => 'n' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
const circ = n => (n <= 20 ? String.fromCharCode(0x2460 + n - 1) : n + '.');
const LET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
const TIERS = ['一次', '副次', '補充'];
const ROLE_LABEL = { req: '要件', exc: 'ただし（例外）', '?': '未設定' };
const SECTIONS = [
  ['purpose', '趣旨・理由づけ（効果として見たとき）', 'なぜこの効果・制度があるのか'],
  ['interp', '解釈・基準（要件として見たとき）', '意味、判断基準、学説・判例の立場'],
  ['factors', '考慮要素（この判断で考えること）', '判断のときに見るポイント、重みの考え方'],
  ['examples', '具体例（判例など）', '事案と結論、判例百選の貼り付けなど'],
  ['note', 'メモ・貼り付け用', '自由メモ（このデータファイルの中にだけ保存されます）'],
];

let data = null;
let selKey = null;            // 選択中の「場所」（根から辿った道筋 a>b>c）
let editing = false;          // 編集モード（名前の編集＋詳細欄）
let expanded = new Set();     // 一階層下を開いている場所
let fileHandle = null, fileName = '', fileDirty = false, lastSaved = null;
let showSampleNote = false, wantFocus = false;
let fileTimer = null, lsTimer = null;
let searchQ = '', searchHits = [], searchIdx = -1;
const frameOpen = new Set();  // 開いている枠組みの表示（場所|枠組みid）
let prefs = { sec: { purpose: true, interp: true, factors: true, examples: true, note: true } };
const canFile = ('showSaveFilePicker' in window) && ('showOpenFilePicker' in window);
const finePointer = window.matchMedia && matchMedia('(pointer:fine)').matches;
