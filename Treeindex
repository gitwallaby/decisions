/* ---------- ブロックを作る・消す・動く ---------- */
function afterCreate(newKey) { selKey = newKey; editing = true; wantFocus = true; changed(); render(); }
function addChild(path) {
  const id = path[path.length - 1], nid = uid();
  data.nodes[nid] = newNode(nid, '');
  data.nodes[id].kids.push({ id: nid, role: '?', w: '', tier: '' });
  const key = path.join('>'); expanded.add(key);
  afterCreate(key + '>' + nid);
}
function addSibling(path, dir) {
  const id = path[path.length - 1], nid = uid();
  data.nodes[nid] = newNode(nid, '');
  if (path.length === 1) {
    const i = data.roots.indexOf(id);
    if (i < 0) data.roots.push(nid); else data.roots.splice(dir < 0 ? i : i + 1, 0, nid);
    afterCreate(nid); return;
  }
  const p = data.nodes[path[path.length - 2]];
  const i = p.kids.findIndex(k => k.id === id);
  p.kids.splice(dir < 0 ? i : i + 1, 0, { id: nid, role: '?', w: '', tier: '' });
  afterCreate(path.slice(0, -1).concat(nid).join('>'));
}
function addUp(path) {   // 親で包む：このブロックを子にする新しい親を作る
  const id = path[path.length - 1], nid = uid();
  const N = newNode(nid, ''); N.kids = [{ id, role: 'req', w: '', tier: '' }]; data.nodes[nid] = N;
  if (path.length === 1) {
    const i = data.roots.indexOf(id);
    if (i >= 0) data.roots[i] = nid; else data.roots.push(nid);
  } else {
    data.nodes[path[path.length - 2]].kids.find(k => k.id === id).id = nid;
  }
  const newPath = path.slice(0, -1).concat(nid), nk = newPath.join('>'), old = path.join('>');
  const add = [];
  expanded.forEach(k => { if (k === old || k.startsWith(old + '>')) add.push(nk + '>' + id + k.slice(old.length)); });
  add.forEach(k => expanded.add(k)); expanded.add(nk);
  afterCreate(nk);
}
function outdent(path) { // 一階層上に作る：親の隣（親の次）に新しいブロック。根では「親で包む」
  if (path.length === 1) { addUp(path); return; }
  const nid = uid(); data.nodes[nid] = newNode(nid, '');
  const parentId = path[path.length - 2];
  if (path.length === 2) {
    const i = data.roots.indexOf(parentId);
    if (i < 0) data.roots.push(nid); else data.roots.splice(i + 1, 0, nid);
    afterCreate(nid); return;
  }
  const gp = data.nodes[path[path.length - 3]];
  const i = gp.kids.findIndex(k => k.id === parentId);
  gp.kids.splice(i + 1, 0, { id: nid, role: '?', w: '', tier: '' });
  afterCreate(path.slice(0, -2).concat(nid).join('>'));
}
