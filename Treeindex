function runAction(id) {
  const path = selKey ? selKey.split('>') : null;
  switch (id) {
    case 'search': { const q = $('#q'); q.focus(); q.select(); return true; }
    case 'exit':
      if (!editing) return false;
      editing = false; if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
      render(); return true;
    case 'edit': if (!path) return false; editing = true; wantFocus = true; render(); return true;
    case 'below': if (!path) return false; addSibling(path, 1); return true;
    case 'above': if (!path) return false; addSibling(path, -1); return true;
    case 'child': if (!path) return false; addChild(path); return true;
    case 'outdent': if (!path) return false; outdent(path); return true;
    case 'up': if (!path) return false; moveSel(-1); return true;
    case 'down': if (!path) return false; moveSel(1); return true;
    case 'expand': {
      if (!path) return false;
      const n = data.nodes[path[path.length - 1]];
      if (!n.kids.length) return true;
      if (!expanded.has(selKey)) { expanded.add(selKey); render(); }
      else { const k = n.kids.find(k => data.nodes[k.id]); if (k) { selKey = selKey + '>' + k.id; render(); } }
      return true;
    }
    case 'collapse':
      if (!path) return false;
      if (expanded.has(selKey)) { expanded.delete(selKey); render(); }
      else if (path.length > 1) { selKey = path.slice(0, -1).join('>'); render(); }
